<!DOCTYPE html><html class="dark" lang="en" style="font-family: Poppins, sans-serif !important; opacity: 0; visibility: visible !important;" data-stitch-anim-opacity="true" data-stitch-orig-opacity="1"><head><style>html, body, #root, main, div { opacity: 1 !important; visibility: visible !important; }</style><meta charset="utf-8"><meta content="width=device-width, initial-scale=1.0" name="viewport"><meta content="web_standard" name="shell-type"><link href="https://fonts.googleapis.com" rel="preconnect"><link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&amp;family=Playfair+Display:wght@600;700&amp;display=swap" rel="stylesheet"><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"><link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&amp;display=swap" rel="stylesheet"><style>@layer base{html,body{margin:0;padding:0;}body{overscroll-behavior:none;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src="https://cdn.tailwindcss.com"></script><script id="tailwind-config">tailwind.config={darkMode:"class",theme:{extend:{"colors":{"secondary-fixed":"#ffdea7","tertiary-fixed":"#ffdad6","inverse-primary":"#9f4100","on-primary-container":"#4f1d00","on-secondary-fixed-variant":"#5e4200","primary-fixed-dim":"#ffb692","primary-fixed":"#ffdbcb","on-tertiary-fixed-variant":"#93000d","secondary-fixed-dim":"#f4be55","surface-container-low":"#1f1b17","on-error":"#690005","surface-container-high":"#2e2926","on-primary-fixed":"#341000","inverse-surface":"#ebe1db","on-primary-fixed-variant":"#7a3000","background":"#171310","on-tertiary-fixed":"#410002","tertiary-container":"#ff5a50","on-error-container":"#ffdad6","surface-dim":"#171310","on-secondary":"#412d00","tertiary-fixed-dim":"#ffb4ab","tertiary":"#ffb4ab","secondary-container":"#986d00","outline":"#a88b7d","error-container":"#93000a","primary-container":"#f26a0f","on-secondary-fixed":"#271900","outline-variant":"#594237","surface-container-highest":"#393430","on-background":"#ebe1db","error":"#ffb4ab","on-secondary-container":"#fffbff","surface":"#171310","on-tertiary-container":"#600005","surface-variant":"#393430","on-surface":"#ebe1db","secondary":"#f4be55","surface-container-lowest":"#110d0a","on-primary":"#562000","on-surface-variant":"#e1c0b1","primary":"#ffb692","surface-container":"#231f1b","surface-tint":"#ffb692","surface-bright":"#3e3834","on-tertiary":"#690006","inverse-on-surface":"#352f2c"},"borderRadius":{"DEFAUL