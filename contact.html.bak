<!-- Interactive JavaScript for Order Formulation & Accordion -->
<script>
    function handleOrderSubmit(event) {
      event.preventDefault();
      
      var name = document.getElementById('custName').value.trim();
      var phone = document.getElementById('custPhone').value.trim();
      var area = document.getElementById('custArea').value;
      var address = document.getElementById('custAddress').value.trim();
      var items = document.getElementById('custItems').value.trim();
      var spice = document.getElementById('spiceLevel').value;
      var payment = document.getElementById('paymentMethod').value;
      var notes = document.getElementById('custNotes').value.trim();

      var message = "🍗 *NEW ORDER / INQUIRY - A-ONE FOODS FAISALABAD*\n\n" +
                    "👤 *Customer:* " + name + "\n" +
                    "📞 *Phone:* " + phone + "\n" +
                    "📍 *Area:* " + area + "\n" +
                    (address ? "🏠 *Address:* " + address + "\n" : "") +
                    "🍽 *Order Details:*\n" + items + "\n\n" +
                    "🌶 *Spice Preference:* " + spice + "\n" +
                    "💳 *Payment Choice:* " + payment + "\n" +
                    (notes ? "📝 *Notes/Cake Tag:* " + notes + "\n" : "") +
                    "\nPlease confirm price and delivery timing!";

      var encodedMessage = encodeURIComponent(message);
      var whatsappUrl = "https://wa.me/923000000000?text=" + encodedMessage;
      
      window.open(whatsappUrl, '_blank');
    }

    function toggleFaq(button) {
      var content = button.nextElementSibling;
      var icon = button.querySelector('.material-symbols-outlined');
      var isHidden = content.classList.contains('hidden');
      
      // Close all first for clean accordion experience
      var allContents = document.querySelectorAll('#faqAccordion > div > div');
      var allIcons = document.querySelectorAll('#faqAccordion > div button .material-symbols-outlined');
      
      allContents.forEach(function(el) { el.classList.add('hidden'); });
      allIcons.forEach(function(i) { i.textContent = 'expand_more'; });

      if (isHidden) {
        content.classList.remove('hidden');
        icon.textContent = 'expand_less';
      }
    }
  </script>
