<!-- Floating Sticky WhatsApp Order Bar (Active when items are in cart) -->
<div class="fixed bottom-6 inset-x-4 md:inset-x-auto md:right-8 md:w-[480px] z-50 transition-all duration-300 transform translate-y-32 opacity-0 pointer-events-none" id="cartBar">
<div class="bg-surface-container-high/95 backdrop-blur-xl p-space-md rounded-2xl shadow-2xl border-0 flex items-center justify-between gap-space-md">
<div class="flex items-center gap-space-sm min-w-0">
<div class="relative w-12 h-12 rounded-xl bg-primary-container flex items-center justify-center text-on-primary-container shrink-0 shadow-lg shadow-primary-container/30">
<span class="material-symbols-outlined text-[24px]">shopping_bag</span>
<span class="absolute -top-1.5 -right-1.5 bg-secondary text-on-secondary font-label-sm text-label-sm font-bold w-5 h-5 rounded-full flex items-center justify-center" id="cartCountBadge">0</span>
</div>
<div class="flex flex-col min-w-0">
<span class="font-label-sm text-label-sm text-secondary uppercase font-bold tracking-wider">A-One Express Cart</span>
<div class="flex items-baseline gap-space-xs">
<span class="font-headline-sm text-headline-sm text-on-surface font-bold" id="cartSubtotal">Rs. 0</span>
<span class="font-body-sm text-body-sm text-outline">(15% off included)</span>
</div>
</div>
</div>
<div class="flex items-center gap-space-xs shrink-0">
<button class="p-2 rounded-xl bg-surface-container hover:bg-surface-container-highest text-on-surface transition-colors" onclick="openCartDrawer()" title="View Cart Details" type="button">
