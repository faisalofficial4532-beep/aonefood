pins, sans-serif !important; opacity: 1; visibility: visible !important;"><header class="fixed top-0 w-full z-50 bg-surface-container-lowest/85 backdrop-blur-md border-b border-outline-variant/30 shadow-[0_1px_8px_rgba(0,0,0,0.25)]"><div class="h-20 max-w-[1360px] mx-auto px-margin-mobile md:px-margin flex items-center justify-between gap-gutter"><div class="flex items-center gap-space-sm"><img alt="A-One Foods Chicken Emblem.png" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/AEtjO1WjwaRNskSPd1Vee3XlamUkuvRA7eCM6xjSE-lSbDjKrBt_dIW6ojGS_2ytbTCpi9gMYaxyB7E_97tu0dw1V-NAzXelPCyv8j1a6-4ycNLsfsD1Xvxy4iskNixCjRYttT7TBW0KaTjaPR02X5oPrReLkdx_fFZPH1jXQobVG2XIvaQq0zUq14VJMMyTCdZo0bX944furweGu9psgUj8Np3OsdEGmgixBQJoDn5Jf9ffqvWSsbGKpmtr3M0ibYZ9FidBWzoMYaOvLQ"><div class="flex flex-col"><span class="font-headline-sm text-headline-sm text-on-surface font-semibold tracking-wide leading-none">A-One Foods</span><span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest mt-0.5">When You Want To Eat</span></div></div><nav class="hidden lg:flex items-center gap-space-lg" data-active-classes="text-primary font-bold"><a class="font-title-md text-title-md text-on-surface-variant hover:text-on-surface transition-colors" data-path="home" href="#">Home</a><a class="font-title-md text-title-md text-on-surface-variant hover:text-on-surface transition-colors" data-path="menu" href="#">Menu</a><a class="font-title-md text-title-md text-on-surface-variant hover:text-on-surface transition-colors" data-path="deals" href="#">Deals</a><a class="font-title-md text-title-md text-on-surface-variant hover:text-on-surface transition-colors" data-path="cakes-sweets" href="#">Cakes &amp; Sweets</a><a class="font-title-md text-title-md text-on-surface-variant hover:text-on-surface transition-colors" data-path="about" href="#">About</a><a aria-current="page" class="transition-colors text-primary font-bold" data-path="contact" href="#">Contact</a></nav><div class="flex items-center gap-space-md"><button class="relative p-space-xs text-on-surface-variant hover:text-on-surface transition-colors flex items-center justify-center" type="button"><span class="material-symbols-outlined text-[24px]">shopping_bag</span><span class="absolute -top-1 -right-1 bg-primary-container text-on-primary-container font-label-sm text-label-sm rounded-full w-5 h-5 flex items-center justify-center font-bold">3</span></button><a class="hidden sm:inline-flex items-center gap-space-xs bg-primary-container text-on-primary-container hover:bg-primary-fixed-dim hover:text-on-primary-fixed font-title-md text-title-md px-space-md py-space-xs rounded-full shadow-[0_4px_16px_rgba(242,106,15,0.35)] transition-all" href="https://wa.me/" rel="noopener noreferrer" target="_blank"><span class="material-symbols-outlined text-[20px]">chat</span><span class="">Order on WhatsApp</span></a><div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center"><span class="material-symbols-outlined text-on-primary text-[18px]">person</span></div></div></div></header><main class="w-full pt-20 bg-surface-container-lowest min-h-screen"><div class="flex flex-col w-full">
<!-- Top Ambient Glow & Cinematic Hero Section -->
<section class="relative w-full overflow-hidden bg-surface-container-lowest py-space-xl lg:py-28">
<div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[720px] h-[360px] bg-primary-container/10 blur-[130px] pointer-events-none rounded-full"></div>
<div class="absolute top-1/4 right-10 w-96 h-96 bg-secondary/5 blur-[120px] pointer-events-none rounded-full"></div>
<div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin relative z-10">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">
<!-- Text Headline Column -->
<div class="lg:col-span-7 flex flex-col">
<div class="inline-flex items-center gap-space-xs px-space-sm py-1 rounded-full bg-surface-container-high border-none w-fit mb-space-sm shadow-sm">
<span class="w-2 h-2 rounded-full bg-primary-container animate-pulse"></span>
<span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">Faisalabad Flagship &amp; Nightly Dispatch</span>
</div>
<h1 class="font-display-hero text-display-hero-mobile md:text-display-hero text-on-surface tracking-tight leading-tight font-bold">
            Get in Touch &amp; <br>
<span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-secondary to-primary-container">Order Direct.</span>
</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl mt-space-md leading-relaxed">
            Hot, crisp, and fresh delivered straight to your doorstep across Faisalabad or reserved steaming at our express takeaway counter. Crafted with heritage nocturnal spices.
          </p>
<div class="flex flex-wrap items-center gap-space-md mt-space-lg">
<a class="inline-flex items-center gap-space-xs bg-primary-container text-on-primary-container hover:bg-primary-fixed-dim hover:text-on-primary-fixed font-title-md text-title-md px-space-lg py-3 rounded-lg shadow-[0_8px_24px_rgba(242,106,15,0.35)] transition-all transform hover:-translate-y-0.5" href="https://wa.me/923000000000?text=Hi%20A-One%20Foods%2C%20I%20would%20like%20to%20place%20an%20order" rel="noopener noreferrer" target="_blank">
<span class="material-symbols-outlined text-[22px]">chat</span>
<span class="">Express WhatsApp Dispatch</span>
</a>
<a class="inline-flex items-center gap-space-xs bg-surface-container-high text-on-surface hover:text-primary font-title-md text-title-md px-space-lg py-3 rounded-lg shadow-sm transition-all" href="#quick-inquiry">
<span class="material-symbols-outlined text-[20px]">restaurant_menu</span>
<span class="">Custom Order Form</span>
</a>
</div>
<!-- Quick Trust Metrics -->
<div class="grid grid-cols-3 gap-space-md mt-space-xl pt-space-md bg-surface-container-low/60 rounded-xl p-space-md max-w-lg shadow-inner">
<div class="flex flex-col">
<span class="font-headline-sm text-headline-sm text-secondary font-bold">25-35m</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">Avg Delivery Speed</span>
</div>
<div class="flex flex-col">
<span class="font-headline-sm text-headline-sm text-primary font-bold">3:00 AM</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">Nightly Kitchen Close</span>
</div>
<div class="flex flex-col">
<span class="font-headline-sm text-headline-sm text-on-surface font-bold">100%</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">Halal &amp; Hand-cut</span>
</div>
</div>
</div>
<!-- Featured Burger Media Box -->
<div class="lg:col-span-5 relative mt-space-lg lg:mt-0">
<div class="relative rounded-2xl overflow-hidden bg-surface-container-high shadow-2xl p-2 group">
<div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-transparent to-transparent z-10 opacity-70"></div>
<img class="w-full h-[400px] lg:h-[480px] object-cover rounded-xl transition-transform duration-700 group-hover:scale-105" data-alt="A gourmet towering crispy fried chicken burger with melted cheddar dripping artisanal sauce on a dark slate board with hot crinkle cut fries in Faisalabad warm ember restaurant lighting" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC7bQPoLDOLeH8Fuy90YoYps_vvWF_oc7WlMCmTLo2jaaTsETR6W-jBN3XKFvg7Xqm5_wOvP_2Xa5ZmUV7BRjKOUykRH7qCJmChfRfKyA3cAqF2AEF3vxl3OrliiOQ5vFwPlmfEFrUXsLm1yLrw5wbhrFVvU7qP-bRGEVTgm_PdiX19kRF82WADlFuhUoYVoQV8dkwcBWWiQ-FXqh_DJ8IF0HNUGxKh3_JKXbwaopSknicg-E4M6qRq">
<div class="absolute bottom-6 left-6 right-6 z-20 flex items-center justify-between bg-surface-container-lowest/85 backdrop-blur-md p-space-sm rounded-lg shadow-lg">
<div class="flex flex-col">
<span class="font-label-sm text-label-sm text-secondary uppercase font-bold tracking-wider">Chef's Night Special</span>
<span class="font-title-md text-title-md text-on-surface">Smash Zinger Royale &amp; Seasoned Fries</span>
</div>
<span class="font-headline-sm text-headline-sm text-primary font-bold">Rs. 890</span>
</div>
</div>
</div>
</div>
</div>
</section>
<!-- Primary Instant Channels Strip -->
<section class="w-full bg-surface-container-low py-space-xl">
<div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin">
<div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
<!-- Channel 1: WhatsApp Hotline -->
<div class="bg-surface-container rounded-2xl p-space-lg shadow-md flex flex-col justify-between relative overflow-hidden transition-all duration-300 hover:-translate-y-1">
<div class="absolute top-0 right-0 w-32 h-32 bg-primary-container/10 rounded-full blur-2xl pointer-events-none"></div>
<div>
<div class="flex items-center justify-between mb-space-md">
<div class="w-12 h-12 rounded-xl bg-surface-container-highest flex items-center justify-center text-primary-container shadow-sm">
<span class="material-symbols-outlined text-[28px]">chat</span>
</div>
<span class="px-space-xs py-1 rounded bg-primary-container/20 text-primary-fixed text-label-sm font-label-sm uppercase font-bold tracking-wider">Direct Order</span>
</div>
<h3 class="font-headline-sm text-headline-sm text-on-surface">Instant WhatsApp</h3>
<p class="font-body-md text-body-md text-on-surface-variant mt-1">
              One-tap dispatch for live GPS drop-off tracking and voice order requests.
            </p>
<p class="font-title-lg text-title-lg text-secondary font-bold mt-space-sm tracking-wide">
              +92 300 0000000
            </p>
</div>
<a class="mt-space-lg inline-flex items-center justify-center gap-space-xs w-full py-2.5 px-space-md rounded-lg bg-primary-container text-on-primary-container font-title-md text-title-md shadow-md hover:bg-primary-fixed-dim transition-colors" href="https://wa.me/923000000000" rel="noopener noreferrer" target="_blank">
<span class="">Open WhatsApp Chat</span>
<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</a>
</div>
<!-- Channel 2: Voice Helpline & Catering -->
<div class="bg-surface-container rounded-2xl p-space-lg shadow-md flex flex-col justify-between relative overflow-hidden transition-all duration-300 hover:-translate-y-1">
<div>
<div class="flex items-center justify-between mb-space-md">
<div class="w-12 h-12 rounded-xl bg-surface-container-highest flex items-center justify-center text-secondary shadow-sm">
<span class="material-symbols-outlined text-[28px]">phone_in_talk</span>
</div>
<span class="px-space-xs py-1 rounded bg-surface-container-high text-secondary text-label-sm font-label-sm uppercase font-bold tracking-wider">Catering &amp; Parties</span>
</div>
<h3 class="font-headline-sm text-headline-sm text-on-surface">Voice Hotline</h3>
<p class="font-body-md text-body-md text-on-surface-variant mt-1">
              For corporate platters, wedding dessert corners, and customized bulk platters.
            </p>
<p class="font-title-lg text-title-lg text-on-surface font-bold mt-space-sm tracking-wide">
              (041) 854-AONE / 0300-8888888
            </p>
</div>
<a class="mt-space-lg inline-flex items-center justify-center gap-space-xs w-full py-2.5 px-space-md rounded-lg bg-surface-container-high text-on-surface hover:text-primary font-title-md text-title-md transition-colors shadow-sm" href="tel:+923000000000">
<span class="">Call Kitchen Direct</span>
<span class="material-symbols-outlined text-[18px]">call</span>
</a>
</div>
<!-- Channel 3: Timings & Late Night Pickup -->
<div class="bg-surface-container rounded-2xl p-space-lg shadow-md flex flex-col justify-between relative overflow-hidden transition-all duration-300 hover:-translate-y-1">
<div>
<div class="flex items-center justify-between mb-space-md">
<div class="w-12 h-12 rounded-xl bg-surface-container-highest flex items-center justify-center text-primary shadow-sm">
<span class="material-symbols-outlined text-[28px]">timelapse</span>
</div>
<span class="px-space-xs py-1 rounded bg-secondary-container/30 text-secondary-fixed text-label-sm font-label-sm uppercase font-bold tracking-wider">Daily Service</span>
</div>
<h3 class="font-headline-sm text-headline-sm text-on-surface">Operational Hours</h3>
<p class="font-body-md text-body-md text-on-surface-variant mt-1">
              Open 7 days a week, serving lunch, dinner, and late-night cravings.
            </p>
<div class="mt-space-sm flex flex-col gap-0.5">
<span class="font-title-md text-title-md text-on-surface font-bold">11:00 AM – 3:00 AM</span>
<span class="font-body-sm text-body-sm text-secondary">Kitchen dispatches until 2:45 AM</span>
</div>
</div>
<div class="mt-space-lg flex items-center gap-space-xs py-2 px-space-sm rounded-lg bg-surface-container-lowest text-on-surface-variant">
<span class="material-symbols-outlined text-[18px] text-secondary">takeout_dining</span>
<span class="font-body-sm text-body-sm">Curbside &amp; Dine-in Available</span>
</div>
</div>
</div>
</div>
</section>
<!-- Interactive Dual-Column Form & Visual Section -->
<section class="w-full bg-surface-container-lowest py-space-xl" id="quick-inquiry">
<div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
<!-- Left Side: Interactive WhatsApp Formulation Form -->
<div class="lg:col-span-7 bg-surface-container-low rounded-2xl p-space-lg md:p-space-xl shadow-xl relative">
<div class="flex flex-col mb-space-md">
<span class="font-label-sm text-label-sm uppercase text-secondary tracking-widest font-bold">Rapid Booking &amp; Takeaway</span>
<h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mt-1">Instant Order Dispatcher</h2>
<p class="font-body-md text-body-md text-on-surface-variant mt-1">
              Fill details below. Our generator creates an actionable order draft formatted straight into our WhatsApp line.
            </p>
</div>
<form class="flex flex-col gap-space-md" id="orderForm" onsubmit="handleOrderSubmit(event)">
<!-- Customer Name & Phone -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
<div class="flex flex-col gap-1">
<label class="font-label-md text-label-md text-on-surface" for="custName">Your Name *</label>
<input class="bg-surface-container-highest text-on-surface px-space-md py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-container font-body-md text-body-md shadow-sm" id="custName" placeholder="e.g. Usman Tariq" required="" type="text">
</div>
<div class="flex flex-col gap-1">
<label class="font-label-md text-label-md text-on-surface" for="custPhone">WhatsApp Phone *</label>
<input class="bg-surface-container-highest text-on-surface px-space-md py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-container font-body-md text-body-md shadow-sm" id="custPhone" placeholder="0300 1234567" required="" type="tel">
</div>
</div>
<!-- Faisalabad Area Selector & Address -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
<div class="flex flex-col gap-1">
<label class="font-label-md text-label-md text-on-surface" for="custArea">Delivery Area / Sector *</label>
<select class="bg-surface-container-highest text-on-surface px-space-md py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-container font-body-md text-body-md shadow-sm" id="custArea" required="">
<option disabled="" selected="" value="">Select Faisalabad Area</option>
<option value="D Ground / Peoples Colony 1">D Ground / Peoples Colony 1</option>
<option value="Peoples Colony 2">Peoples Colony 2</option>
<option value="Kohinoor City / Jaranwala Rd">Kohinoor City / Jaranwala Rd</option>
<option value="Madina Town / Susan Road">Madina Town / Susan Road</option>
<option value="FDA City / Sargodha Road">FDA City / Sargodha Road</option>
<option value="Canal Road / Eden Gardens">Canal Road / Eden Gardens</option>
<option value="Civil Lines / Jail Road">Civil Lines / Jail Road</option>
<option value="Gulberg / Jhang Road">Gulberg / Jhang Road</option>
<option value="Takeaway Pickup at Flagship">Self Takeaway Pickup (Counter)</option>
</select>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-md text-label-md text-on-surface" for="custAddress">Street Address / Landmark</label>
<input class="bg-surface-container-highest text-on-surface px-space-md py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-container font-body-md text-body-md shadow-sm" id="custAddress" placeholder="House #, Street, Near landmark" type="text">
</div>
</div>
<!-- Order / Menu Selection -->
<div class="flex flex-col gap-1">
<label class="font-label-md text-label-md text-on-surface" for="custItems">Meal, Sweets or Party Request *</label>
<textarea class="bg-surface-container-highest text-on-surface px-space-md py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-container font-body-md text-body-md shadow-sm" id="custItems" placeholder="e.g. 2x Zinger Supreme Meals, 1x 12pc Crispy Broast Bucket, 1x Belgian Chocolate Cake (2 Lbs)" required="" rows="3"></textarea>
</div>
<!-- Spice Level & Addons -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
<div class="flex flex-col gap-1">
<label class="font-label-md text-label-md text-on-surface" for="spiceLevel">Spice Level Preference</label>
<select class="bg-surface-container-highest text-on-surface px-space-md py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-container font-body-md text-body-md shadow-sm" id="spiceLevel">
<option value="Regular Crispy">Regular Crispy (Mild)</option>
<option value="Medium Spicy A-One">Medium Spicy Signature</option>
<option value="Fiery Ghost Pepper">Fiery Ghost Pepper Extra Hot</option>
<option value="Not Applicable (Desserts only)">Not Applicable (Bakery/Sweets)</option>
</select>
</div>
<div class="flex flex-col gap-1">
<label class="font-label-md text-label-md text-on-surface" for="paymentMethod">Preferred Payment</label>
<select class="bg-surface-container-highest text-on-surface px-space-md py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-container font-body-md text-body-md shadow-sm" id="paymentMethod">
<option value="Cash on Delivery">Cash on Delivery (COD)</option>
<option value="JazzCash / EasyPaisa">JazzCash / EasyPaisa Instant Transfer</option>
<option value="Credit / Debit Card on Delivery">Card Swipe Machine at Doorstep</option>
</select>
</div>
</div>
<!-- Special Requests / Notes -->
