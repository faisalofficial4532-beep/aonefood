<span class="material-symbols-outlined text-[20px]">chat</span>
<span class="">WhatsApp</span>
</button>
</div>
</div>
</div>
<!-- Detailed Slide-in WhatsApp Order Cart Modal / Drawer -->
<div class="fixed inset-0 z-50 bg-black/75 backdrop-blur-sm hidden transition-opacity" id="cartModal">
<div class="absolute inset-y-0 right-0 w-full max-w-md bg-surface-container-high p-space-lg flex flex-col justify-between shadow-2xl">
<div>
<div class="flex items-center justify-between pb-space-md border-b-0">
<div class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-primary-container text-[26px]">dinner_dining</span>
<h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">Your Feast Tray</h3>
</div>
<button class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant hover:text-on-surface" onclick="closeCartDrawer()" type="button">
<span class="material-symbols-outlined text-[20px]">close</span>
</button>
</div>
<p class="font-body-sm text-body-sm text-secondary mt-space-xs">Instant WhatsApp Dispatch • Faisalabad Hotline</p>
<!-- Cart Items List Container -->
<div class="flex flex-col gap-space-sm mt-space-md max-h-[512px] overflow-y-auto pr-1" id="cartItemsList">
<!-- Dynamically inserted -->
</div>
</div>
<div class="pt-space-md">
<div class="bg-surface-container p-space-md rounded-xl flex flex-col gap-space-xs mb-space-md">
<div class="flex justify-between font-body-sm text-body-sm text-on-surface-variant">
<span class="">Special Promotional Discount</span>
<span class="text-error font-semibold">-15% Applied</span>
</div>
<div class="flex justify-between font-body-sm text-body-sm text-on-surface-variant">
<span class="">Standard Delivery</span>
<span class="text-secondary">Calculated via WhatsApp</span>
</div>
<div class="flex justify-between font-title-lg text-title-lg font-bold text-on-surface pt-space-xs">
<span class="">Subtotal:</span>
<span class="text-primary-container" id="drawerTotal">Rs. 0</span>
</div>
</div>
<div class="flex flex-col gap-space-xs">
<button class="w-full py-space-sm rounded-xl bg-primary-container text-on-primary-container hover:bg-primary-fixed-dim font-title-md text-title-md font-bold transition-all flex items-center justify-center gap-space-xs shadow-lg shadow-primary-container/30" onclick="checkoutOnWhatsApp()" type="button">
<span class="material-symbols-outlined text-[22px]">chat</span>
<span class="">Send Order via WhatsApp</span>
</button>
<button class="w-full py-2 text-center font-label-md text-label-md text-outline hover:text-on-surface transition-colors" onclick="clearCart()" type="button">
            Clear Order Tray
          </button>
</div>
</div>
</div>
</div>
<!-- Notification Toast Component -->
<div class="fixed top-24 left-1/2 -translate-x-1/2 z-50 bg-surface-container-highest text-on-surface px-space-md py-space-xs rounded-full shadow-xl flex items-center gap-space-xs pointer-events-none transition-all duration-300 opacity-0 -translate-y-4" id="toast">
<span class="material-symbols-outlined text-primary-container text-[20px]">check_circle</span>
<span class="font-body-md text-body-md font-semibold" id="toastMsg">Added to your order tray</span>
</div>
</div>
<script>
  // State
  let cart = [];
  let activeCategory = 'all';
  let activeTag = 'all';
  let searchQuery = '';

  // DOM Elements
  const cartBar = document.getElementById('cartBar');
  const cartModal = document.getElementById('cartModal');
  const cartCountBadge = document.getElementById('cartCountBadge');
  const cartSubtotal = document.getElementById('cartSubtotal');
  const drawerTotal = document.getElementById('drawerTotal');
  const cartItemsList = document.getElementById('cartItemsList');
  const searchInput = document.getElementById('searchInput');
  const clearSearch = document.getElementById('clearSearch');
  const noResultsState = document.getElementById('noResultsState');
  const toast = document.getElementById('toast');
  const toastMsg = document.getElementById('toastMsg');

  // Add Item to Cart
  function addToCart(name, price, category) {
    const existingIndex = cart.findIndex(item => item.name === name);
    if (existingIndex > -1) {
      cart[existingIndex].qty += 1;
    } else {
      cart.push({ name, price, qty: 1, category });
    }
    updateCartUI();
    showToast(`Added: ${name}`);
  }

  // Update Cart Quantity
  function updateQty(name, delta) {
    const item = cart.find(i => i.name === name);
    if (!item) return;
    item.qty += delta;
    if (item.qty <= 0) {
      cart = cart.filter(i => i.name !== name);
    }
    updateCartUI();
  }

  // Clear Entire Cart
  function clearCart() {
    cart = [];
    updateCartUI();
    closeCartDrawer();
    showToast('Tray cleared');
  }

  // Render & Synchronize Cart UI
  function updateCartUI() {
    const totalItems = cart.reduce((acc, i) => acc + i.qty, 0);
    const subtotal = cart.reduce((acc, i) => acc + (i.price * i.qty), 0);
    const formattedPrice = `Rs. ${subtotal.toLocaleString('en-PK', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}`;

    cartCountBadge.textContent = totalItems;
    cartSubtotal.textContent = formattedPrice;
    drawerTotal.textContent = formattedPrice;

    // Toggle Floating Cart Bar visibility
    if (totalItems > 0) {
      cartBar.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');
      cartBar.classList.add('translate-y-0', 'opacity-100');
    } else {
      cartBar.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
      cartBar.classList.remove('translate-y-0', 'opacity-100');
    }

    // Render Drawer List
    if (cart.length === 0) {
      cartItemsList.innerHTML = `
        <div class="py-8 text-center text-outline font-body-md text-body-md">
          Your tray is empty. Add your favorite crispy and savory delights!
        </div>
      `;
    } else {
      cartItemsList.innerHTML = cart.map(item => `
        <div class="flex items-center justify-between p-space-sm rounded-xl bg-surface-container">
          <div class="flex flex-col min-w-0 pr-2">
            <span class="font-title-md text-title-md text-on-surface truncate">${item.name}</span>
            <span class="font-body-sm text-body-sm text-primary-container font-semibold">Rs. ${(item.price * item.qty).toFixed(1)}</span>
          </div>
          <div class="flex items-center gap-space-xs shrink-0">
            <button type="button" onclick="updateQty('${item.name}', -1)" class="w-7 h-7 rounded-lg bg-surface-container-high hover:bg-surface-container-highest text-on-surface flex items-center justify-center font-bold">-</button>
            <span class="font-title-md text-title-md text-on-surface px-1 min-w-[20px] text-center">${item.qty}</span>
            <button type="button" onclick="updateQty('${item.name}', 1)" class="w-7 h-7 rounded-lg bg-surface-container-high hover:bg-surface-container-highest text-on-surface flex items-center justify-center font-bold">+</button>
          </div>
        </div>
      `).join('');
    }
  }

  // Toast Notification
  function showToast(message) {
    toastMsg.textContent = message;
    toast.classList.remove('opacity-0', '-translate-y-4');
    toast.classList.add('opacity-100', 'translate-y-0');
    setTimeout(() => {
      toast.classList.add('opacity-0', '-translate-y-4');
      toast.classList.remove('opacity-100', 'translate-y-0');
    }, 2200);
  }

  // Open & Close Drawer
  function openCartDrawer() {
    cartModal.classList.remove('hidden');
  }

  function closeCartDrawer() {
    cartModal.classList.add('hidden');
  }

  // Checkout Format to WhatsApp
  function checkoutOnWhatsApp() {
    if (cart.length === 0) {
      showToast('Please add items to your cart first.');
      return;
    }

    const subtotal = cart.reduce((acc, i) => acc + (i.price * i.qty), 0);
    let msg = `*Assalam-o-Alaikum! New Order from A-One Foods Website:*%0A%0A`;
    cart.forEach((item, index) => {
      msg += `${index + 1}. *${item.name}* x ${item.qty} = Rs. ${(item.price * item.qty).toFixed(1)}%0A`;
    });
    msg += `%0A------------------------%0A`;
    msg += `*Order Subtotal (15% Off Applied):* Rs. ${subtotal.toFixed(1)}%0A`;
    msg += `*Branch:* Main Boulevard, Faisalabad%0A`;
    msg += `*Please confirm order timing and delivery address.*`;

    // Opens WhatsApp API
    const whatsappUrl = `https://wa.me/923001234567?text=${msg}`;
    window.open(whatsappUrl, '_blank');
  }

  // Category Filtering Logic
  const catPills = document.querySelectorAll('.cat-pill');
  catPills.forEach(pill => {
    pill.addEventListener('click', () => {
      catPills.forEach(p => {
        p.classList.remove('active', 'bg-primary-container', 'text-on-primary-container', 'shadow-md');
        p.classList.add('bg-surface-container-high', 'text-on-surface-variant');
      });
      pill.classList.add('active', 'bg-primary-container', 'text-on-primary-container', 'shadow-md');
      pill.classList.remove('bg-surface-container-high', 'text-on-surface-variant');
      activeCategory = pill.getAttribute('data-cat');
      filterMenu();
    });
  });

  // Tag Filtering Logic
  const tagBtns = document.querySelectorAll('.tag-filter-btn');
  tagBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tagBtns.forEach(b => {
        b.classList.remove('bg-primary-container', 'text-on-primary-container', 'shadow-sm');
        b.classList.add('bg-surface-container', 'text-on-surface-variant');
      });
      btn.classList.add('bg-primary-container', 'text-on-primary-container', 'shadow-sm');
      btn.classList.remove('bg-surface-container', 'text-on-surface-variant');
      activeTag = btn.getAttribute('data-tag');
      filterMenu();
    });
  });

  // Search Input Listener
  searchInput.addEventListener('input', (e) => {
    searchQuery = e.target.value.toLowerCase().trim();
    if (searchQuery.length > 0) {
      clearSearch.classList.remove('hidden');
    } else {
      clearSearch.classList.add('hidden');
    }
    filterMenu();
  });

  clearSearch.addEventListener('click', () => {
    searchInput.value = '';
    searchQuery = '';
    clearSearch.classList.add('hidden');
    filterMenu();
  });

  // Master Filter Function
  function filterMenu() {
    const sections = document.querySelectorAll('.menu-section');
    let totalVisibleItems = 0;

    sections.forEach(section => {
      const sectionCategory = section.getAttribute('data-category');
      const items = section.querySelectorAll('.menu-item-card');
      let visibleCountInSection = 0;

      // Category matching
      const matchesCategory = (activeCategory === 'all' || activeCategory === sectionCategory);

      items.forEach(item => {
        const itemName = item.getAttribute('data-name') || '';
        const itemTags = item.getAttribute('data-tags') || '';

        const matchesSearch = searchQuery === '' || itemName.includes(searchQuery);
        const matchesTag = activeTag === 'all' || itemTags.includes(activeTag);

        if (matchesCategory && matchesSearch && matchesTag) {
          item.classList.remove('hidden');
          visibleCountInSection++;
          totalVisibleItems++;
        } else {
          item.classList.add('hidden');
        }
      });

      // Show/Hide section header based on visible items
      if (visibleCountInSection > 0) {
        section.classList.remove('hidden');
      } else {
        section.classList.add('hidden');
      }
    });

    if (totalVisibleItems === 0) {
      noResultsState.classList.remove('hidden');
      noResultsState.classList.add('flex');
    } else {
      noResultsState.classList.add('hidden');
      noResultsState.classList.remove('flex');
    }
  }

  function resetFilters() {
    searchInput.value = '';
    searchQuery = '';
    clearSearch.classList.add('hidden');
    activeTag = 'all';
    activeCategory = 'all';

    tagBtns.forEach((b, idx) => {
      if (idx === 0) {
        b.classList.add('bg-primary-container', 'text-on-primary-container');
        b.classList.remove('bg-surface-container', 'text-on-surface-variant');
      } else {
        b.classList.remove('bg-primary-container', 'text-on-primary-container');
        b.classList.add('bg-surface-container', 'text-on-surface-variant');
      }
    });

    catPills.forEach((p, idx) => {
      if (idx === 0) {
        p.classList.add('active', 'bg-primary-container', 'text-on-primary-container');
        p.classList.remove('bg-surface-container-high', 'text-on-surface-variant');
      } else {
        p.classList.remove('active', 'bg-primary-container', 'text-on-primary-container');
        p.classList.add('bg-surface-container-high', 'text-on-surface-variant');
      }
    });

    filterMenu();
  }

  // Close Cart Modal when clicking outside the panel
  cartModal.addEventListener('click', (e) => {
    if (e.target === cartModal) {
      closeCartDrawer();
    }
  });
</script></main><footer class="w-full bg-surface-container-lowest border-t border-outline-variant/30 text-on-surface-variant pt-space-xl pb-space-lg"><div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin"><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter mb-space-xl"><div class="flex flex-col gap-space-sm"><div class="flex items-center gap-space-sm"><img alt="A-One Foods Chicken Emblem.png" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/AEtjO1WjwaRNskSPd1Vee3XlamUkuvRA7eCM6xjSE-lSbDjKrBt_dIW6ojGS_2ytbTCpi9gMYaxyB7E_97tu0dw1V-NAzXelPCyv8j1a6-4ycNLsfsD1Xvxy4iskNixCjRYttT7TBW0KaTjaPR02X5oPrReLkdx_fFZPH1jXQobVG2XIvaQq0zUq14VJMMyTCdZo0bX944furweGu9psgUj8Np3OsdEGmgixBQJoDn5Jf9ffqvWSsbGKpmtr3M0ibYZ9FidBWzoMYaOvLQ"><span class="font-headline-sm text-headline-sm text-on-surface font-semibold">A-One Foods</span></div><p class="font-headline-sm text-headline-sm text-secondary italic">"When You Want To Eat"</p><p class="font-body-md text-body-md text-on-surface-variant mt-space-xs">Crafting unforgettable nocturnal culinary experiences in Faisalabad with hand-roasted spices, golden crispy chicken, and artisan confectioneries.</p><div class="inline-flex items-center gap-space-xs mt-space-sm px-space-sm py-space-xs rounded bg-surface-container-high border border-outline-variant/40 w-fit"><span class="material-symbols-outlined text-secondary text-[18px]">verified</span><span class="font-label-sm text-label-sm text-secondary font-bold uppercase tracking-wider">100% Halal Certified</span></div></div><div class="flex flex-col gap-space-sm"><h4 class="font-title-lg text-title-lg text-on-surface font-semibold">Quick Links</h4><ul class="flex flex-col gap-space-xs"><li class="font-body-md text-body-md"><a class="hover:text-primary transition-colors" href="#">Chef's Signature Menu</a></li><li class="font-body-md text-body-md"><a class="hover:text-primary transition-colors" href="#">Exclusive Family Deals</a></li><li class="font-body-md text-body-md"><a class="hover:text-primary transition-colors" href="#">Artisan Cakes &amp; Sweets</a></li><li class="font-body-md text-body-md"><a class="hover:text-primary transition-colors" href="#">Our Heritage &amp; Craft</a></li><li class="font-body-md text-body-md"><a class="hover:text-primary transition-colors" href="#">Direct Support &amp; Inquiries</a></li></ul></div><div class="flex flex-col gap-space-sm"><h4 class="font-title-lg text-title-lg text-on-surface font-semibold">Visit &amp; Timing</h4><div class="flex items-start gap-space-xs"><span class="material-symbols-outlined text-primary text-[20px] mt-0.5">schedule</span><div><p class="font-title-md text-title-md text-on-surface">Store Timings</p><p class="font-body-md text-body-md text-on-surface-variant">Open Daily: 11:00 AM – 3:00 AM</p><p class="font-body-sm text-body-sm text-secondary">Late Night Takeaway &amp; Delivery</p></div></div><div class="flex items-start gap-space-xs mt-space-xs"><span class="material-symbols-outlined text-primary text-[20px] mt-0.5">location_on</span><div><p class="font-title-md text-title-md text-on-surface">Flagship Location</p><p class="font-body-md text-body-md text-on-surface-variant">Main Boulevard, Faisalabad, Pakistan</p></div></div></div><div class="flex flex-col gap-space-sm"><h4 class="font-title-lg text-title-lg text-on-surface font-semibold">Ordering Hotline</h4><p class="font-body-md text-body-md text-on-surface-variant">Instant dispatch and bespoke catering orders via WhatsApp hotline.</p><a class="inline-flex items-center gap-space-xs text-primary font-title-lg text-title-lg hover:underline" href="https://wa.me/"><span class="material-symbols-outlined text-[20px]">call</span><span class="">+92 300 1234567</span></a><div class="mt-space-sm"><p class="font-label-md text-label-md text-on-surface uppercase tracking-wider mb-space-xs">Connect With Us</p><div class="flex items-center gap-space-sm"><a aria-label="Instagram" class="w-9 h-9 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors" href="#"><span class="material-symbols-outlined text-[18px]">photo_camera</span></a><a aria-label="Facebook" class="w-9 h-9 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors" href="#"><span class="material-symbols-outlined text-[18px]">public</span></a><a aria-label="TikTok" class="w-9 h-9 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors" href="#"><span class="material-symbols-outlined text-[18px]">music_note</span></a></div></div></div></div><div class="pt-space-md border-t border-outline-variant/20 flex flex-col sm:flex-row items-center justify-between gap-space-sm text-center sm:text-left"><p class="font-body-sm text-body-sm text-on-surface-variant">© 2025 A-One Foods. All rights reserved. Faisalabad, Pakistan.</p><div class="flex items-center gap-space-md font-body-sm text-body-sm"><a class="hover:text-on-surface transition-colors" href="#">Privacy Policy</a><a class="hover:text-on-surface transition-colors" href="#">Terms of Service</a><a class="hover:text-on-surface transition-colors" href="#">FSSAI &amp; Halal Standards</a></div></div></div></footer>



