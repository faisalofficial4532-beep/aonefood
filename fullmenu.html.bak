l, body { opacity: 1 !important; visibility: visible !important; }</style></head><body class="bg-surface text-on-surface font-body-md text-body-md" style="font-family: Poppins, sans-serif;"><header class="fixed top-0 w-full z-50 bg-surface-container-lowest/85 backdrop-blur-md border-b border-outline-variant/30 shadow-[0_1px_8px_rgba(0,0,0,0.25)]"><div class="h-20 max-w-[1360px] mx-auto px-margin-mobile md:px-margin flex items-center justify-between gap-gutter"><div class="flex items-center gap-space-sm"><img alt="A-One Foods Chicken Emblem.png" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/AEtjO1WjwaRNskSPd1Vee3XlamUkuvRA7eCM6xjSE-lSbDjKrBt_dIW6ojGS_2ytbTCpi9gMYaxyB7E_97tu0dw1V-NAzXelPCyv8j1a6-4ycNLsfsD1Xvxy4iskNixCjRYttT7TBW0KaTjaPR02X5oPrReLkdx_fFZPH1jXQobVG2XIvaQq0zUq14VJMMyTCdZo0bX944furweGu9psgUj8Np3OsdEGmgixBQJoDn5Jf9ffqvWSsbGKpmtr3M0ibYZ9FidBWzoMYaOvLQ"><div class="flex flex-col"><span class="font-headline-sm text-headline-sm text-on-surface font-semibold tracking-wide leading-none">A-One Foods</span><span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest mt-0.5">When You Want To Eat</span></div></div><nav class="hidden lg:flex items-center gap-space-lg" data-active-classes="text-primary font-bold"><a class="font-title-md text-title-md text-on-surface-variant hover:text-on-surface transition-colors" data-path="home" href="#">Home</a><a aria-current="page" class="transition-colors text-primary font-bold" data-path="menu" href="#">Menu</a><a class="font-title-md text-title-md text-on-surface-variant hover:text-on-surface transition-colors" data-path="deals" href="#">Deals</a><a class="font-title-md text-title-md text-on-surface-variant hover:text-on-surface transition-colors" data-path="cakes-sweets" href="#">Cakes &amp; Sweets</a><a class="font-title-md text-title-md text-on-surface-variant hover:text-on-surface transition-colors" data-path="about" href="#">About</a><a class="font-title-md text-title-md text-on-surface-variant hover:text-on-surface transition-colors" data-path="contact" href="#">Contact</a></nav><div class="flex items-center gap-space-md"><button class="relative p-space-xs text-on-surface-variant hover:text-on-surface transition-colors flex items-center justify-center" type="button"><span class="material-symbols-outlined text-[24px]">shopping_bag</span><span class="absolute -top-1 -right-1 bg-primary-container text-on-primary-container font-label-sm text-label-sm rounded-full w-5 h-5 flex items-center justify-center font-bold">3</span></button><a class="hidden sm:inline-flex items-center gap-space-xs bg-primary-container text-on-primary-container hover:bg-primary-fixed-dim hover:text-on-primary-fixed font-title-md text-title-md px-space-md py-space-xs rounded-full shadow-[0_4px_16px_rgba(242,106,15,0.35)] transition-all" href="https://wa.me/" rel="noopener noreferrer" target="_blank"><span class="material-symbols-outlined text-[20px]">chat</span><span class="">Order on WhatsApp</span></a><div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center"><span class="material-symbols-outlined text-on-primary text-[18px]">person</span></div></div></div></header><main class="w-full pt-20 bg-surface-container-lowest min-h-screen"><div class="flex flex-col w-full">
<!-- Top Visual Banner with Dark Ambient Stage Glow -->
<div class="relative w-full overflow-hidden bg-surface-container-lowest py-space-xl">
<div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[720px] h-[360px] bg-primary-container/15 rounded-full blur-[120px] pointer-events-none"></div>
<div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin relative z-10 flex flex-col md:flex-row md:items-end justify-between gap-gutter">
<div class="max-w-2xl flex flex-col gap-space-xs">
